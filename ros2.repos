repositories:
  athena_custom_msgs_pkg:
    type: git
    url: https://github.com/Autonomous-System-ZHAW/athena-custom-msgs-pkg.git 
    version: main
    path: athena_custom_msgs_pkg

  athena_follow_the_gap:
    type: git
    url: https://github.com/Autonomous-System-ZHAW/athena_follow_the_gap.git 
    version: vesc-integration
    path: follow_the_gap

  athena_ldlidar_stl_ros2:
    type: git
    url: https://github.com/Autonomous-System-ZHAW/athena-ldlidar-stl-ros2.git 
    version: main
    path: athena_ldlidar_stl_ros2

  transport_drivers:
    type: git
    url: https://github.com/ros-drivers/transport_drivers.git
    version: main
    path: transport_drivers

  athena_vesc_controller:
    type: git
    url: https://github.com/Autonomous-System-ZHAW/athena_vesc_controller.git
    version: dev
    path: athena_vesc_controller

  athena_remote_control:
    type: git
    url: https://github.com/Autonomous-System-ZHAW/athena_remote_control.git
    version: main
    path: athena_remote_control

  athena_lifecycle_state_machine:
    type: git
    url: https://github.com/Autonomous-System-ZHAW/athena_lifecycle_state_machine.git
    version: main
    path: athena_lifecycle_state_machine

  athena_autonomous_racing:
    type: git
    url: https://github.com/Autonomous-System-ZHAW/athena_autonomous_racing.git
    version: main
    path: athena_autonomous_racing

  athena_steering_wheel_drive:
    type: git
    url: https://github.com/Autonomous-System-ZHAW/athena_steering_wheel_drive.git
    version: main
    path: athena_steering_wheel_drive
