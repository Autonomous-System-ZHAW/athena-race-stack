{
    "name": "${localWorkspaceFolderBasename} ROS2 Dev-Container",
    "privileged": true,                 // access to serial devices, SPI and GPIO
    "remoteUser": "${localEnv:USER}",
    "build": {
        "context": "..",
        "dockerfile": "../docker/Dockerfile",
        "target": "dev",
        "args": {
            "USERNAME": "${localEnv:USER}",
            "USER_UID": "1000",
            "USER_GID": "1000",
            "WS_BASENAME": "${localWorkspaceFolderBasename}"
        }
    },
    "workspaceFolder": "/home/${localEnv:USER}/ros2_ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/${localEnv:USER}/ros2_ws/${localWorkspaceFolderBasename},type=bind",
    "customizations": {
        "vscode": {
            "settings": {
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter",
                    "editor.formatOnSave": true,
                    "editor.formatOnSaveMode": "file"
                },
                "files.associations": {
                    "*.rviz": "yaml",
                    "*.urdf": "xml",
                    "*.xacro": "xml",
                    "*.repos": "yaml"
                },
                "git.repositoryScanMaxDepth": 3
            },
            // Keep this list short: extensions run on the Pi's CPU
            "extensions": [
                "ms-python.python",
                "ms-python.black-formatter",
                "mhutchie.git-graph",
                "ranch-hand-robotics.rde-pack"
            ]
        }
    },
    "containerEnv": {
        // Dev only: use the file from the repo so edits apply without rebuild.
        // Deploy uses the copy baked into the image (see docker/Dockerfile).
        "FASTRTPS_DEFAULT_PROFILES_FILE": "/home/${localEnv:USER}/ros2_ws/${localWorkspaceFolderBasename}/config/fastdds.xml"
    },
    "runArgs": [
        "--hostname=${localWorkspaceFolderBasename}-devcontainer",
        "--network=host",
        "--ipc=host"
    ],
    "features": {
        "ghcr.io/devcontainers/features/git": {}
    },
    "postCreateCommand": "bash ${containerWorkspaceFolder}/${localWorkspaceFolderBasename}/.devcontainer/post_create.sh"
}